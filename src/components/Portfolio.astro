---
import SiteHeader from './SiteHeader.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import SiteFooter from './SiteFooter.astro';
import type { Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div
  class="mx-auto flex max-w-[1600px] flex-col px-6 sm:px-10 lg:grid lg:grid-cols-12 lg:gap-x-12 lg:px-12"
>
  <SiteHeader lang={lang} />

  <main
    id="content"
    class="pt-6 pb-4 lg:col-span-7 lg:col-start-6 lg:py-20"
  >
    <Hero lang={lang} />
    <About lang={lang} />
    <Experience lang={lang} />
    <Projects lang={lang} />
    <Contact lang={lang} />
    <SiteFooter lang={lang} />
  </main>
</div>

<script>
  // Scroll-spy: highlight the active jump link (only client-side behaviour
  // besides analytics).
  const links = Array.from(document.querySelectorAll('.nav-link'));
  const sections = Array.from(document.querySelectorAll('main section[id]'));

  if (links.length > 0 && 'IntersectionObserver' in window) {
    const byId = new Map(
      links.map((link) => [
        link.getAttribute('href')?.replace('#', ''),
        link,
      ]),
    );

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => link.classList.remove('is-active'));
          byId.get(entry.target.id)?.classList.add('is-active');
        }
      },
      { rootMargin: '-30% 0px -55% 0px' },
    );

    sections.forEach((section) => observer.observe(section));

    // At the page bottom the last section may sit outside the observed band.
    const activate = (link: Element | undefined) => {
      if (!link) return;
      links.forEach((item) => item.classList.remove('is-active'));
      link.classList.add('is-active');
    };

    window.addEventListener(
      'scroll',
      () => {
        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 4;
        if (atBottom) activate(links.at(-1));
      },
      { passive: true },
    );
  }
</script>
