---
import { anchors, headings, t, type Lang } from "../data/i18n";
import { jobs } from "../data/experience";
import SectionHeading from "./SectionHeading.astro";
import RichText from "./RichText.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id={anchors[lang].experience} class="mt-24 scroll-mt-16 lg:mt-32">
  <SectionHeading index="02" title={t(headings.experience, lang)} />

  <div class="mt-8 space-y-10">
    {
      jobs.map((job) => (
        <article class="group grid gap-y-2 md:grid-cols-[10rem_1fr] md:gap-x-6">
          <header class="md:top-24">
            <h3 class="text-base font-semibold text-text transition-colors group-hover:text-accent">
              {job.company}
            </h3>
          </header>
          <div>
            <h4 class="font-semibold text-accent">{t(job.role, lang)}</h4>
            <p class="mt-1 font-mono text-xs text-muted">
              {t(job.dates, lang)}
            </p>
            <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
              {job.bullets.map((bullet) => (
                <li class="bullet">
                  <RichText text={t(bullet, lang)} />
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
