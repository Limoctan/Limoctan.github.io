---
interface Props {
  index: string;
  title: string;
}

const { index, title } = Astro.props;
---

<h2 class="flex items-center gap-4">
  <span class="font-mono text-sm font-normal text-accent">{index}.</span>
  <span class="text-2xl font-bold text-accent">{title}</span>
  <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
</h2>
