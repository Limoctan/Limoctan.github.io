---
import { site } from "../data/site";
import { getIcon } from "../icons/techIcons";

interface Props {
  label: string;
  class?: string;
  iconClass?: string;
}

const {
  label,
  class: className = "flex items-center gap-5",
  iconClass = "h-6 w-6",
} = Astro.props;

const links: {
  href: string;
  text: string;
  name: "Email" | "Phone" | "Linkedin" | "Github";
}[] = [
  { name: "Github", href: site.social.github, text: "GitHub" },
  { name: "Linkedin", href: site.social.linkedin, text: "LinkedIn" },
];
---

<ul class={className} aria-label={label}>
  {
    links.map((link) => {
      const Icon = getIcon(link.name);
      return (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            aria-label={link.text}
            class="icon-link block text-muted"
          >
            <Icon class={iconClass} />
          </a>
        </li>
      );
    })
  }
</ul>
