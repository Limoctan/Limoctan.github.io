---
import { icons } from '../icons/data';

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
const icon = icons[name];
---

{
  icon && (
    <svg
      viewBox="0 0 24 24"
      class={className}
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d={icon.path} />
    </svg>
  )
}
