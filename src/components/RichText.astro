---
interface Props {
  /** Text with `**bold**` markers; known tech names also get an inline icon. */
  text: string;
}

const { text } = Astro.props;
const parts = text.split(/(\*\*[^*]+\*\*)/g).filter(Boolean);
---

{
  parts.map((part) => {
    if (!part.startsWith("**")) return <Fragment set:text={part} />;
    const label = part.slice(2, -2);

    return <strong class="font-semibold text-text">{label}</strong>;
  })
}
