---
import { anchors, headings, t, ui, type Lang } from '../data/i18n';
import { projects } from '../data/projects';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id={anchors[lang].projects} class="mt-24 scroll-mt-16 lg:mt-32">
  <SectionHeading index="03" title={t(headings.projects, lang)} />

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      projects.map((project) => (
        <article class="group flex flex-col overflow-hidden rounded-md border border-line bg-bg-raised transition duration-300 hover:-translate-y-1 hover:border-accent/60 hover:bg-bg-hover">
          <div class="aspect-[16/10] overflow-hidden border-b border-line">
            <img
              src={project.image}
              alt=""
              width="800"
              height="500"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
            />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-semibold text-text transition-colors group-hover:text-accent">
              {lang === 'es' ? project.title_es : project.title_en}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              {lang === 'es' ? project.desc_es : project.desc_en}
            </p>
            <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-muted">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <div class="mt-5 flex items-center gap-5 pt-1 font-mono text-xs">
              <a
                href={project.links.demo}
                class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-accent"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <path d="M15 3h6v6" />
                  <path d="M10 14 21 3" />
                </svg>
                {t(ui.projectDemo, lang)}
              </a>
              <a
                href={project.links.code}
                class="inline-flex items-center gap-1.5 text-muted transition-colors hover:text-accent"
              >
                <Icon name="github" class="h-3.5 w-3.5" />
                {t(ui.projectCode, lang)}
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
