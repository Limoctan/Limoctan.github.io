---
import { anchors, navLinks, t, ui, type Lang } from '../data/i18n';
import { profile } from '../data/profile';
import LangToggle from './LangToggle.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<header
  class="flex flex-col px-1 pt-10 sm:px-0 lg:sticky lg:top-0 lg:col-span-5 lg:min-h-screen lg:self-start lg:py-20"
>
  <div>
    <h1 class="text-4xl font-bold tracking-tight text-text sm:text-5xl">
      {profile.name}
    </h1>
    <p class="mt-3 max-w-md text-lg font-medium leading-snug text-accent">
      {t(profile.headline, lang)}
    </p>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-muted">
      {t(profile.tagline, lang)}
    </p>
  </div>

  <nav
    aria-label={t(ui.jumpTo, lang)}
    class="mt-12 hidden lg:block"
  >
    <ul class="space-y-5">
      {
        navLinks.map((link) => (
          <li>
            <a
              class="nav-link flex items-center"
              href={`#${anchors[lang][link.id]}`}
            >
              <span class="nav-indicator mr-5" aria-hidden="true" />
              <span class="nav-label text-sm font-medium">
                {t(link.label, lang)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <SocialLinks
    label={t(ui.social, lang)}
    class="mt-8 flex items-center gap-5 lg:mt-12"
  />

  <!-- Mobile: toggle sits above the name; desktop: pinned to the bottom. -->
  <LangToggle
    lang={lang}
    class="order-first mb-10 lg:order-none lg:mb-0 lg:mt-auto"
  />
</header>
